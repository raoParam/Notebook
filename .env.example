# ── Metered.ca TURN Server Credentials ──────────────────────────────
# Free tier TURN relay credentials for cross-device WebRTC P2P sync.
# Copy this file to .env.local and fill in real values.
# Both are required for TURN relay; without them the app falls back to STUN-only.
NEXT_PUBLIC_METERED_APP_NAME=
NEXT_PUBLIC_METERED_API_KEY=
